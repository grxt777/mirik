# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
MODEL=z-ai/glm-5.3-flash

# Telegram: токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram ID владельцев через запятую (узнать: @userinfobot). Пусто = первый написавший станет владельцем
OWNER_IDS=

# Админка
ADMIN_PASSWORD=change-me
# Публичный URL (для кнопки Mini App в Telegram), напр. https://mirik.fly.dev
PUBLIC_URL=http://localhost:8080
PORT=8080
DATA_DIR=./data
